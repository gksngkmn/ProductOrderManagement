PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SUPER_ADMIN_USER=replace-with-superadmin-username
SUPER_ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash

DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_order_management
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password

MAIL_MODE=development
MAIL_HOST=replace-with-mail-host
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-with-mail-user
MAIL_PASS=replace-with-mail-password
MAIL_FROM_NAME=Product Order Management
MAIL_FROM_EMAIL=replace-with-sender-email
MANAGER_EMAIL=replace-with-manager-email

SMS_MODE=development
NETGSM_USERCODE=replace-with-netgsm-usercode
NETGSM_PASSWORD=replace-with-netgsm-password
NETGSM_MSGHEADER=replace-with-netgsm-header
